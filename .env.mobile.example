# Mobile-specific backend environment variables

# Which push notification provider the mobile backend should use.
MOBILE_PUSH_PROVIDER=expo

# Secret or key material used to sign or authorize mobile push notifications.
MOBILE_PUSH_SECRET=

# Base URL used by mobile clients to call the backend API.
MOBILE_API_URL=https://api.amana.example.com

# Base URL used for mobile-accessible CDN assets (evidence, receipts, thumbnails).
MOBILE_CDN_BASE_URL=https://cdn.amana.example.com

# Mobile token lifetimes
MOBILE_TOKEN_LIFETIME_SECONDS=3600
MOBILE_REFRESH_TOKEN_LIFETIME_SECONDS=1209600
